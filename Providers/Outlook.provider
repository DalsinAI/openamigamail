# Outlook.com, Hotmail, Live and Microsoft 365
name    = Outlook.com
domains = outlook.com hotmail.com hotmail.co.uk live.com live.co.uk msn.com
imap    = outlook.office365.com 993 tls
smtp    = smtp.office365.com 587 starttls
auth    = xoauth2-device
oauth.device = https://login.microsoftonline.com/common/oauth2/v2.0/devicecode
oauth.token  = https://login.microsoftonline.com/common/oauth2/v2.0/token
oauth.scope  = https://outlook.office.com/IMAP.AccessAsUser.All https://outlook.office.com/SMTP.Send offline_access
oauth.client = REGISTER-ME
note    = Microsoft accepts only OAuth: sign in once with the code shown, on any device with a browser.
